  "components": {
    "schemas": {
      "Body_frame_api_v1_pasos_frame_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "caseta": {
            "type": "integer",
            "title": "Caseta"
          },
          "sentido": {
            "type": "string",
            "enum": [
              "ENTRADA",
              "SALIDA",
              "AUTO"
            ],
            "title": "Sentido"
          },
          "preview": {
            "type": "boolean",
            "title": "Preview",
            "default": false
          },
          "sesion": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Sesion"
          }
        },
        "type": "object",
        "required": [
          "file",
          "caseta",
          "sentido",
          "sesion"
        ],
        "title": "Body_frame_api_v1_pasos_frame_post"
      },
      "Body_image_question_api_v1_chat_imagen_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_image_question_api_v1_chat_imagen_post"
      },
      "Body_lookup_image_api_v1_placas_consultar_imagen_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_lookup_image_api_v1_placas_consultar_imagen_post"
      },
      "Correction": {
        "properties": {
          "placa": {
            "type": "string",
            "pattern": "^[0-9]{3,4}[A-Z]{3}$",
            "title": "Placa"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "moto",
              "auto",
              "minibus",
              "camion",
              "bus"
            ],
            "title": "Categoria"
          },
          "ejes": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 2.0,
            "title": "Ejes"
          },
          "motivo": {
            "type": "string",
            "maxLength": 500,
            "minLength": 4,
            "title": "Motivo"
          }
        },
        "type": "object",
        "required": [
